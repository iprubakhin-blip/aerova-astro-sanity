---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getInsights} from '../../lib/content';
const insights = await getInsights();
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Insights | AEROVA" description="Ideas and perspectives on thoughtful energy operations, software design and more connected decision-making.">
  <section class="subhero"><div class="container"><span class="eyebrow">PERSPECTIVES</span><h1>Ideas worth<br/><em>exploring.</em></h1><p>Fresh angles on the intersection of technology, people and a changing energy world.</p></div></section>
  <section class="section page-section"><div class="container"><div class="insight-grid">{insights.map((entry,i) => <a class="insight-card" href={`${base}insights/${entry.slug}/`}><div class={`insight-art art-${(i%3)+1}`}><div class="art-rings"></div><span class="art-number">0{i+1}</span></div><div class="insight-meta"><span>{entry.category}</span><time datetime={entry.publishedAt}>{new Date(entry.publishedAt).toLocaleDateString('en-US',{month:'short',year:'numeric'})}</time></div><h2>{entry.title}</h2><p>{entry.excerpt}</p><span class="read-link">Read perspective ↗</span></a>)}</div></div></section>
</BaseLayout>
