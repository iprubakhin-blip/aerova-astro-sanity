---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Solutions | AEROVA" description="Explore the capabilities of the AEROVA energy intelligence platform concept.">
  <section class="subhero"><div class="container"><span class="eyebrow">WHAT WE IMAGINE</span><h1>Everything you need.<br/><em>Nothing you don't.</em></h1><p>A connected set of tools to make complex energy systems easier to understand and operate.</p></div></section>
  <section class="section page-section"><div class="container feature-list">
    <article class="feature-row"><span>01 / MONITOR</span><div><h2>Know what's happening.</h2><p>Bring energy signals and operational health into one readable workspace. Spot changes, filter the noise, and keep the important details in focus.</p></div><div class="feature-emblem">◉</div></article>
    <article class="feature-row"><span>02 / ANTICIPATE</span><div><h2>Look beyond the now.</h2><p>Explore trends and illustrative forecasts in a visual environment designed to support human judgment, not replace it.</p></div><div class="feature-emblem">↗</div></article>
    <article class="feature-row"><span>03 / ACT</span><div><h2>Close the loop.</h2><p>Connect context to workflow. Turn observations into accountable next steps with clear ownership and accessible documentation.</p></div><div class="feature-emblem">✳</div></article>
  </div></section>
  <section class="closing-cta"><div class="container closing-inner"><span class="eyebrow">START WITH CLARITY</span><h2>Make space for<br/>better decisions<span>.</span></h2><a class="btn btn-lime" href={`${base}contact/`}>Get in touch ↗</a></div></section>
</BaseLayout>
