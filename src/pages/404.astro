---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Page not found | AEROVA" description="The page you're looking for doesn't exist."><section class="subhero not-found"><div class="container"><span class="eyebrow">404 / OFF THE GRID</span><h1>A little off<br/><em>the map.</em></h1><p>We couldn't find that page. Let's get you back on track.</p><a href={base} class="btn btn-lime">Back to home ↗</a></div></section></BaseLayout>
